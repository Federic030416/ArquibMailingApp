<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArquibMailing.Maui.ViewModels"
             x:Class="ArquibMailing.Maui.Pages.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="#1F2E51">
    <Grid>
        <!--Fondo con un degradado de azul profundo y sofisticado-->
        <Border StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F2E51" Offset="0.0"/> <!-- Delf Blue -->
                    <GradientStop Color="#080F24" Offset="1.0"/> <!-- Prussian Blue -->
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="24" WidthRequest="400" Padding="24">
                <!--Tarjeta Blanca del formulario flotante-->
                <Border BackgroundColor="White"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 20"
                        Padding="32"
                        Shadow="{Shadow Brush=Black, Offset='0,10', Radius=25, Opacity=0.25}">
                    <!--Contenedor vertical de campos y botón-->
                    <VerticalStackLayout Spacing="20">
                        <!-- Logo de la Empresa -->
                        <Image Source="logo.png"
                               HeightRequest="80"
                               WidthRequest="200"
                               HorizontalOptions="Center"
                               Aspect="AspectFit"
                               Margin="0,0,0,10" />
                        <!--Input 1: Usuario-->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="USUARIO"
                                   FontFamily="BicycletteNormal"
                                   FontSize="11"
                                   CharacterSpacing="1.2"
                                   TextColor="#1F2E51"/>
                            <Border BackgroundColor="#EFEDED"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                
                                <!-- Datatrigger por si hay un error en usuario -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding TieneUsuarioError}" 
                                                 Value="True">
                                        <Setter Property="Stroke" Value="#EF476F"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Placeholder="ejemplo@grupoarquib.com"
                                       FontFamily="BicycletteRegular"
                                       Text="{Binding Usuario, Mode=TwoWay}"
                                       Keyboard="Email"
                                       TextColor="#080F24"
                                       BackgroundColor="Transparent"
                                       HeightRequest="44" />
                            </Border>
                            
                            <!-- Mensaje de error especifico debajo del campo -->
                            <Label Text="{Binding ErrorMessageUsuario}"
                                   FontFamily="BicycletteItalic"
                                   TextColor="#EF476F"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   IsVisible="{Binding TieneUsuarioError}"/>
                        </VerticalStackLayout>
                        <!-- Input 2: Contraseña -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CONTRASEÑA"
                                   FontFamily="BicycletteNormal"
                                   FontSize="11"
                                   CharacterSpacing="1.2"
                                   TextColor="#1F2E51"/>
                            <Border BackgroundColor="#EFEDED"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                
                                <!-- DataTrigger para el error en contraseña -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding TienePasswordError}"
                                                 Value="True">
                                        <Setter Property="Stroke" Value="#EF476F"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <!-- Grid para poner el input y el icono del ojo al lado-->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Placeholder="••••••••"
                                           FontFamily="BicycletteRegular"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           IsPassword="{Binding OcultarPassword}"
                                           TextColor="#080F24"
                                           BackgroundColor="Transparent"
                                           HeightRequest="44" />
                                    
                                    <!--Imagen del ojo vectorial-->
                                    <Image Grid.Column="1"
                                           Source="{Binding IconoOjo}"
                                           HeightRequest="20"
                                           WidthRequest="20"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           Margin="0,0,5,0">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </Border>
                        
                            <!--Mensaje de error debajo de la contraseña-->
                            <Label Text="{Binding ErrorMessagePassword}"
                                   FontFamily="BicycletteItalic"
                                   TextColor="#EF476F"
                                   FontSize="11"
                                   Margin="4,0,0,0"
                                   IsVisible="{Binding TienePasswordError}"/>
                        </VerticalStackLayout>
                        <!--Recuperar Contraseña-->
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontFamily="BicycletteRegular"
                               FontSize="13"
                               TextColor="#AC8743"
                               FontAttributes="Bold"
                               TextDecorations="Underline"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,10">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OlvidePasswordCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <!--Botón iniciar sesión-->
                        <Button Text="INICIAR SESIÓN"
                                FontFamily="BicycletteBlack"
                                Command="{Binding IniciarSesionCommand}"
                                BackgroundColor="#4163B4"
                                TextColor="White"
                                FontSize="14"
                                CharacterSpacing="1.5"
                                CornerRadius="10"
                                HeightRequest="48"
                                Margin="0,10,0,0"
                                Shadow="{Shadow Brush=#4163B4, Offset='0,4', Radius=8, Opacity=0.3}"/>
                        
                        <!--Loader-->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#4163B4"
                                           HeightRequest="30" />
                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
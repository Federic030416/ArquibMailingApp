<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Paleta de colores de la empresa  -->
    <Color x:Key="Primary">#0F2B46</Color>
    <Color x:Key="PrimaryLight">#1A3D5C</Color>
    <Color x:Key="PrimaryDark">#091E33</Color>
    <Color x:Key="Accent">#00B4D8</Color>
    <Color x:Key="AccentLight">#90E0EF</Color>
    <Color x:Key="AccentDark">#0077B6</Color>
    <Color x:Key="Success">#06D6A0</Color>
    <Color x:Key="SuccessLight">#E6FFF6</Color>
    <Color x:Key="Warning">#FFB703</Color>
    <Color x:Key="Danger">#EF476F</Color>
    <Color x:Key="DangerLight">#FFF0F3</Color>

    <!-- Superficies -->
    <Color x:Key="Surface">#F7F9FC</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceHover">#EDF2F7</Color>
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderMedium">#CBD5E1</Color>

    <!--  Textos  -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="TextOnDark">#F8FAFC</Color>
    <Color x:Key="TextAccent">#0077B6</Color>

    <!-- Compatibilidad (requeridos por Styles.xaml) -->
    <Color x:Key="PrimaryDarkText">#0F172A</Color>
    <Color x:Key="Secondary">#E0F2FE</Color>
    <Color x:Key="SecondaryDarkText">#0077B6</Color>
    <Color x:Key="Tertiary">#0F2B46</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F2B46</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>